{
  "name": "@razohq/triage",
  "version": "0.1.0",
  "description": "Morning triage for Playwright runs narrated by razo: clusters CI failures by cause, classifies them (regression, flaky, environment, stale test), names the suspect commits, and reports them. Deterministic, no model calls.",
  "license": "MIT",
  "author": "Mitchell Lombardo <razohq@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razohq/razo.git",
    "directory": "packages/triage"
  },
  "bugs": "https://github.com/razohq/razo/issues",
  "homepage": "https://github.com/razohq/razo/tree/main/packages/triage#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "triage": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./fakes": {
      "types": "./dist/fakes.d.ts",
      "default": "./dist/fakes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "testing",
    "triage",
    "flaky-tests",
    "ci",
    "test-reporting",
    "razo"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
